doctype html
html(lang="en")
  head
    meta(http-equiv="Content-Type" content="text/html; charset=UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Reset your password
  body(style="margin:0; padding:0; background-color:#f3f4f6;")
    table(role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#f3f4f6;")
      tr
        td(align="center" style="padding:32px 16px;")
          table(role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="max-width:600px; background:#ffffff; border-radius:12px; overflow:hidden; box-shadow:0 4px 24px rgba(0,0,0,0.08);")
            tr
              td(style="padding:24px 24px 0 24px; background:linear-gradient(135deg, #ef4444, #f59e0b);")
                table(role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0")
                  tr
                    td(style="padding:8px 0 20px 0;")
                      table(role="presentation" cellpadding="0" cellspacing="0" border="0")
                        tr
                          td(style="background:#ffffff; color:#111827; font-weight:700; font-family:Arial, Helvetica, sans-serif; font-size:16px; line-height:1; letter-spacing:.5px; width:40px; height:40px; border-radius:8px; text-align:center;") TM
                          td(style="font-family:Arial, Helvetica, sans-serif; color:#ffffff; padding-left:12px; font-size:16px;")
                            strong Transport Manager
                            div(style="opacity:.9; font-weight:400;") Password assistance
            tr
              td(style="padding:24px;")
                table(role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0")
                  tr
                    td(style="font-family:Arial, Helvetica, sans-serif; color:#111827; font-size:20px; font-weight:700; padding-bottom:8px;")
                      | Reset your password#{firstName ? ',' : ''} #{firstName}
                  tr
                    td(style="font-family:Arial, Helvetica, sans-serif; color:#4b5563; font-size:14px; line-height:22px; padding-bottom:16px;")
                      | We received a request to reset your password. Click the button below to set a new one.
                  tr
                    td(align="center" style="padding:8px 0 8px 0;")
                      a(href=url target="_blank" style="background:linear-gradient(135deg,#ef4444,#f59e0b); color:#ffffff; text-decoration:none; display:inline-block; padding:12px 20px; border-radius:8px; font-family:Arial, Helvetica, sans-serif; font-weight:700; font-size:14px;")
                        | Reset Password
                  tr
                    td(style="font-family:Arial, Helvetica, sans-serif; color:#6b7280; font-size:12px; line-height:20px; padding-top:16px;")
                      | This reset link is valid for the next 10 minutes. If you did not request a password reset, you can safely ignore this email.
                  tr
                    td(style="font-family:Arial, Helvetica, sans-serif; color:#6b7280; font-size:12px; line-height:20px; padding-top:16px;")
                      | If the button doesn't work, copy and paste this link into your browser:
                      br
                      a(href=url style="color:#ef4444; word-break:break-all; text-decoration:none;") #{url}
            tr
              td(align="center" style="padding:0 24px 24px 24px;")
                table(role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0")
                  tr
                    td(style="font-family:Arial, Helvetica, sans-serif; color:#9ca3af; font-size:12px; line-height:18px; text-align:center;")
                      | © #{new Date().getFullYear()} Transport Manager. All rights reserved.
